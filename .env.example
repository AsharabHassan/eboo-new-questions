# Copy this file to .env.local and fill in real values.
# Both city CRM webhooks are required for successful intake; other services are optional.

# ---------- GoHighLevel calendar ----------
# Booking widget URL for your free consultation calendar.
# Get it from HighLevel: Calendars > [your calendar] > Share > Permanent Link.
# Format: https://api.leadconnectorhq.com/widget/booking/{calendar_id}
NEXT_PUBLIC_GHL_CALENDAR_URL=

# Separate URL for screening calls (used when a quiz flags a safety contraindication).
# Falls back to NEXT_PUBLIC_GHL_CALENDAR_URL if not set.
NEXT_PUBLIC_GHL_SCREENING_CALENDAR_URL=

# ---------- GoHighLevel inbound webhook (CRM ingestion) ----------
# Server-side webhook URL where every completed quiz is POSTed as flat JSON.
# Setup: GHL > Automation > Workflows > New Workflow > Inbound Webhook trigger.
# Copy the webhook URL here, then in the workflow map JSON fields like
# first_name / email / toxic_load_score / protocol_track / safety_status /
# answer_lifestyle / answer_symptoms / ... to your contact custom fields.
# Format: https://services.leadconnectorhq.com/hooks/{location_id}/webhook-trigger/{trigger_id}
# This is the LONDON webhook. No cross-city fallback is used.
GHL_WEBHOOK_URL=

# Glasgow inbound webhook. Leads who pick "Glasgow" on the location question are
# POSTed here instead. Missing/rejected delivery returns a retryable error to the form.
GHL_WEBHOOK_URL_GLASGOW=

# ---------- Resend (transactional email) ----------
# Get a key at https://resend.com — free tier sends 3,000 emails/month.
RESEND_API_KEY=

# Verified domain the emails send FROM. Must be a domain you control.
# Example: HSW Assessment <noreply@hsw.london>
RESEND_FROM="HSW Assessment <noreply@example.com>"

# Where new lead notifications go (the clinic inbox).
CLINIC_EMAIL=hello@example.com

# ---------- Optional: app base URL (used in email links, sitemap, OG) ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Plausible Analytics (privacy-friendly, cookieless) ----------
# Your verified domain in Plausible. Leave blank to disable analytics in dev.
# Example: hsw.london
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ---------- Public-page measurement ----------
# Explicitly configured public-page PageView only. No hardcoded pixel fallback.
# Never forward health fields or rename blocked events to bypass restrictions.
# Source/campaign metadata is retained internally in the GHL payload and intake notes.
NEXT_PUBLIC_META_PIXEL_ID=

# ---------- Optional Lead conversion (OFF until eligibility is confirmed) ----------
# Set both switches true only when Meta permits this actual EBOO submission event.
# Visitor consent is separately required; public-page cookie consent is insufficient.
META_LEAD_ENABLED=false
NEXT_PUBLIC_META_LEAD_ENABLED=false
# Server secret; never prefix the access token with NEXT_PUBLIC_.
META_CAPI_ACCESS_TOKEN=
# Set to a currently supported Graph API version for your Meta app, e.g. vNN.N.
META_GRAPH_API_VERSION=
# Test Events code for a controlled test; remove before production sending.
META_CAPI_TEST_CODE=
